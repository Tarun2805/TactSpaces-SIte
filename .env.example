# Optional GA4 web stream Measurement ID (not a property ID or GTM container ID).
# Leave blank to disable analytics. Example: G-XXXXXXXXXX
# Vite embeds this public value at build time; rebuild/redeploy after changing it.
VITE_GA_MEASUREMENT_ID=

# Apps Script Web app deployment URL ending in /exec (public, not a secret).
# See docs/lead-capture.md. Leave blank to disable enquiry submission safely.
# Vite embeds this value at build time; rebuild/redeploy after changing it.
VITE_GOOGLE_APPS_SCRIPT_URL=
